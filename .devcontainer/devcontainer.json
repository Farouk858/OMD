{
  "name": "On My Deen Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "cd mobile && npm install",
  "forwardPorts": [8081, 5000],
  "portsAttributes": {
    "8081": { "label": "Expo Dev Server", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "msjsdiag.vscode-react-native"
      ]
    }
  }
}
